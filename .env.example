# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anonymous/public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service-role key — NEVER expose to the browser; server-only
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── App ─────────────────────────────────────────────────────────────────────
# Public URL of the deployed app (used for OAuth redirects, email links, etc.)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── Authentication ───────────────────────────────────────────────────────────
# Secret used to HMAC-sign kid session cookies; min 32 random bytes, base64-encoded
KID_SESSION_SECRET=your_kid_session_secret_min_32_bytes

# ─── Cron jobs ────────────────────────────────────────────────────────────────
# Shared secret passed as Bearer token by Vercel cron to authenticate /api/tasks/* routes
CRON_SECRET=your_cron_secret

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# ─── AI providers ─────────────────────────────────────────────────────────────
# OpenAI (used for chore/mission suggestions)
OPENAI_API_KEY=sk-your_openai_api_key

# Anthropic (used for AI coaching features)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Secret key (server-only); use sk_test_* in development, sk_live_* in production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Webhook signing secret — obtained from the Stripe dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Price ID for the subscription product (create in Stripe dashboard)
STRIPE_PRICE_ID=price_your_stripe_price_id

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Contact email used in the VAPID Authorization header
VAPID_EMAIL=mailto:your@email.com

# ─── Admin dashboard ─────────────────────────────────────────────────────────
# HTTP Basic Auth password for /admin/* routes (required; no default)
ADMIN_HEALTH_PASSWORD=your_admin_health_password

# Optional username shown in browser auth dialog (default: "admin")
ADMIN_HEALTH_USERNAME=admin

# ─── Sentry error tracking ────────────────────────────────────────────────────
# Public DSN — safe to expose to the browser
NEXT_PUBLIC_SENTRY_DSN=https://your_key@oXXXXXX.ingest.sentry.io/XXXXXXX

# Server-side DSN (can be the same value or a separate DSN)
SENTRY_DSN=https://your_key@oXXXXXX.ingest.sentry.io/XXXXXXX

# Used by Sentry CLI to upload source maps (CI/CD only; not needed locally)
SENTRY_AUTH_TOKEN=sntrys_your_sentry_auth_token
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=kidsxtra

# ─── SRE Alerting ─────────────────────────────────────────────────────────────
# Email address to receive P0/P1 incident alerts (falls back to VAPID_EMAIL)
ALERT_EMAIL=oncall@your-domain.com

# Sentry webhook shared secret — set in Sentry → Settings → Integrations → Webhooks
SENTRY_WEBHOOK_SECRET=your_sentry_webhook_secret

# GitHub personal access token with issues:write scope (for auto-creating incident issues)
GITHUB_TOKEN=ghp_your_github_token

# GitHub repo to open incident issues in, e.g. "yourorg/kidsxtra"
GITHUB_ALERT_REPO=yourorg/kidsxtra
